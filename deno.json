{
  "tasks": {
    "serve": "deno -A ./src/index.ts",
    "serve:dev": "deno -A --watch ./src/index.ts",
    "prod": "deno run db:migrate && deno run serve",
    "drizzle": "deno run -A drizzle-kit",
    "biome": "deno run -A @biomejs/biome",
    "fmt": "deno run -A @biomejs/biome check --fix",
    "db:generate": "deno run -A drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "deno run -A drizzle-kit migrate --config ./drizzle.config.ts",
    "db:reset": "deno -A ./src/db/scripts/reset.ts",
    "db:seed": "deno -A ./src/db/scripts/seed.ts",
    "job:badgesCorrection": "deno run -A src/badges/jobs/unlockBadgesForUsersWithNoActivityAfterBadgesRollout.ts"
  },
  "imports": {
    "@biomejs/biome": "npm:@biomejs/biome@2.2.4",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.3.8",
    "@graphql-tools/executor-http": "npm:@graphql-tools/executor-http@^3.0.1",
    "@logtape/logtape": "jsr:@logtape/logtape@^1.1.0",
    "@logtape/pretty": "jsr:@logtape/pretty@^1.1.0",
    "@panva/jose": "jsr:@panva/jose@^6.1.0",
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/http": "jsr:@std/http@^1.0.20",
    "@std/random": "jsr:@std/random@^0.1.2",
    "@std/testing": "jsr:@std/testing@^1.0.15",
    "@taras/graphql-tag": "jsr:@taras/graphql-tag@^0.1.3",
    "@types/pg": "npm:@types/pg@^8.15.5",
    "@valibot/valibot": "jsr:@valibot/valibot@^1.1.0",
    "drizzle-kit": "npm:drizzle-kit@^0.31.4",
    "drizzle-orm": "npm:drizzle-orm@^0.44.5",
    "drizzle-seed": "npm:drizzle-seed@^0.3.1",
    "graphql": "npm:graphql@^16.11.0",
    "graphql-scalars": "npm:graphql-scalars@^1.24.2",
    "graphql-yoga": "npm:graphql-yoga@^5.15.2",
    "pg": "npm:pg@^8.16.3",
    "posthog-node": "npm:posthog-node@^5.8.4",
    "ts-pattern": "npm:ts-pattern@^5.8.0",
    "ulid": "npm:ulid@^3.0.1"
  },
  "nodeModulesDir": "auto",
  "unstable": ["temporal"],
  "test": {
    "include": ["tests/**/*.test.ts"]
  }
}
